# --- Supabase ---
# Trouvables dans Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...
# Clé service_role : NE JAMAIS exposer côté client. Utilisée uniquement dans les routes serveur.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# --- Configuration des rôles ---
# Liste des IDs Discord (numériques) des Gérants Médecin, séparés par des virgules.
# Ex: 123456789012345678,987654321098765432
GERANT_DISCORD_IDS=

# URL publique de l'app (utile pour les redirections OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
